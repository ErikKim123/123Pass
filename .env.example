# Copy to `.env.local` and fill in real values. NEVER commit secrets.
# Design Ref: §10.3 / supabase/README.md.

# Supabase — local dev defaults shown; production overrides via deploy platform.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role — SERVER ONLY. Never expose to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: HIBP for the security audit module (module-11).
# HIBP_API_KEY=

# Optional: error reporting (module-11).
# SENTRY_DSN=
