{
  "name": "@123pass/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app lib --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf .expo dist .turbo coverage"
  },
  "dependencies": {
    "@123pass/core-crypto": "workspace:*",
    "@123pass/shared": "workspace:*",
    "@123pass/vault-sdk": "workspace:*",
    "expo": "~51.0.0",
    "expo-clipboard": "~6.0.0",
    "expo-crypto": "~13.0.0",
    "expo-linking": "~6.3.0",
    "expo-local-authentication": "~14.0.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "3.31.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.74",
    "@types/react-native": "^0.73.0"
  }
}
